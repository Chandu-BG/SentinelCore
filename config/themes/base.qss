/* NovaSentinel Premium Base QSS Template */

QMainWindow, QWidget#centralWidget {
    background-color: {{COLOR_BG}};
    color: {{COLOR_TEXT}};
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
}

/* Sidebar */
QWidget#sidebar {
    background-color: {{COLOR_SIDEBAR}};
    border-right: 1px solid {{COLOR_BORDER}};
    min-width: 240px;
}

QPushButton#navButton {
    background: transparent;
    color: {{COLOR_TEXT_SECONDARY}};
    border: none;
    padding: 12px 20px;
    text-align: left;
    font-size: 14px;
    border-radius: 8px;
    margin: 4px 10px;
}

QPushButton#navButton:hover {
    background-color: rgba(47, 129, 247, 0.1);
    color: {{COLOR_TEXT}};
}

QPushButton#navButton[active="true"] {
    background-color: {{COLOR_ACCENT}};
    color: white;
    font-weight: bold;
}

/* Cards */
QFrame#dashboardCard, QFrame#feedCard, QFrame#statusCard, QFrame#phishCard, QFrame#performanceCard {
    background-color: {{COLOR_SURFACE}};
    border: 1px solid {{COLOR_BORDER}};
    border-radius: 12px;
}

/* Tables & Lists */
QTableWidget, QTreeWidget, QListWidget {
    background-color: {{COLOR_SURFACE}};
    border: 1px solid {{COLOR_BORDER}};
    border-radius: 12px;
    gridline-color: {{COLOR_BORDER}};
    color: {{COLOR_TEXT}};
    outline: none;
}

QTableWidget::item, QTreeWidget::item {
    padding: 10px;
    border-bottom: 1px solid {{COLOR_BORDER}};
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: rgba(47, 129, 247, 0.2);
    color: {{COLOR_ACCENT}};
}

QHeaderView::section {
    background-color: {{COLOR_SIDEBAR}};
    color: {{COLOR_TEXT_SECONDARY}};
    border: none;
    border-bottom: 1px solid {{COLOR_BORDER}};
    padding: 12px;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 11px;
}

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background-color: {{COLOR_BG}};
    color: {{COLOR_TEXT}};
    border: 1px solid {{COLOR_BORDER}};
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: {{COLOR_ACCENT}};
}

QLineEdit:focus, QComboBox:focus {
    border-color: {{COLOR_ACCENT}};
}

QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

/* Buttons */
QPushButton {
    background-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT}};
    border: 1px solid {{COLOR_BORDER}};
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
}

QPushButton:hover {
    border-color: {{COLOR_ACCENT}};
    background-color: rgba(47, 129, 247, 0.05);
}

QPushButton:pressed {
    background-color: rgba(47, 129, 247, 0.1);
}

/* ScrollBars */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: {{COLOR_BORDER}};
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: {{COLOR_ACCENT}};
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: {{COLOR_BORDER}};
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Labels */
QLabel {
    color: {{COLOR_TEXT}};
}

QLabel#secondary {
    color: {{COLOR_TEXT_SECONDARY}};
}

/* ToolTips */
QToolTip {
    background-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT}};
    border: 1px solid {{COLOR_ACCENT}};
    padding: 5px;
    border-radius: 4px;
}
